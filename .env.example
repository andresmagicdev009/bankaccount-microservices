# Environment consumed by docker-compose.yml.
# Copy this file to .env before running `docker compose up --build`.
#
# The values below are the local development defaults: the bank-db container
# starts with MARIADB_ALLOW_EMPTY_ROOT_PASSWORD=yes, so the password is empty.
# Set a real password here, and in the environment of the db service, for any
# deployment outside the local machine.

SPRING_DATASOURCE_ACCOUNT_URL = jdbc:mysql://db:3306/accounts_ms?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_CUSTOMER_URL = jdbc:mysql://db:3306/customers_ms?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME = user
SPRING_DATASOURCE_PASSWORD = password
CUSTOMERS_SERVICE_URL = http://ms-customers:8081/api/v1
